# Aura admin console (apps/admin) — copy to .env.local (gitignored). Server-side only: nothing here reaches the browser.
# docs/setup/admin-console.md explains every value.

# NestJS API (the console talks only to its /admin routes)
AURA_API_URL=http://127.0.0.1:3310

# Supabase Auth (staff sign-in: Google Workspace SSO + TOTP; the email code is development only). Local values:
# supabase/LOCAL.md. The publishable/anon key is used server-side only, to call GoTrue for the staff member's own session.
SUPABASE_URL=http://127.0.0.1:55521
SUPABASE_ANON_KEY=

# The console's own public URL: the SSO callback is ${ADMIN_CONSOLE_URL}/login/callback (add it to Supabase Auth →
# URL Configuration → Redirect URLs). Production: https://console.<your-domain>
ADMIN_CONSOLE_URL=http://localhost:3320

# REQ-ADM-01 Google Workspace SSO (Supabase's Google provider). Unset = no SSO button (local development).
# ADMIN_SSO_DOMAIN is the Workspace domain sent to Google as the `hd` hint; the API enforces the domain itself
# (its ADMIN_SSO_ALLOWED_DOMAINS).
ADMIN_SSO_PROVIDER=
ADMIN_SSO_DOMAIN=

# The email-code sign-in is DEVELOPMENT ONLY: shown by default outside production, hidden and refused by default in
# production builds. Set true only for a stack without SSO (the API must allow it too).
ADMIN_ALLOW_EMAIL_LOGIN=

# Seals the session cookie (AES-256-GCM). At least 32 random characters: openssl rand -base64 48
ADMIN_COOKIE_SECRET=

# Console sessions end after this many hours from sign-in (NestJS enforces the same limit: ADMIN_SESSION_MAX_HOURS).
ADMIN_SESSION_MAX_HOURS=12
