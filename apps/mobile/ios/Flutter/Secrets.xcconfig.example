// Copy to Flutter/Secrets.xcconfig (gitignored) and fill in.
// docs/setup/social-sign-in.md
//
// The iOS OAuth client id reversed: "1234-abc.apps.googleusercontent.com"
// becomes "com.googleusercontent.apps.1234-abc" (it's also REVERSED_CLIENT_ID
// in a GoogleService-Info.plist downloaded after the iOS client exists).
AURA_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.REPLACE_ME
