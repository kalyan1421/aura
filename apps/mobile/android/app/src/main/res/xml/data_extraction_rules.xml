<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31): exclude all app data from cloud backup and from
     device-to-device transfer. The local database, the Keystore-wrapped
     secure prefs and voice-note files (app files dir, `voice/`) must never be
     copied to another device or a backup: the server is the restore path
     (PRD 16-offline "Local store"; DS-1). Older versions use
     android:allowBackup="false" / fullBackupContent="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
