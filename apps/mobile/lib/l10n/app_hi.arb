  "companion_storm7": "अंदर जो भी उमड़ रहा हो, आपने उसे पहचाना। इसकी अहमियत है।",
  "companion_storm8": "तूफ़ान में भी, आपकी चमक आपकी अपनी है।",
  "companion_rain1": "यह भारी लग रहा है। आपकी रोशनी अब भी आपके साथ है।",
  "companion_rain2": "बुझे-से दिन के बारे में सच कहना हिम्मत की बात है। आपने अपना साथ दिया।",
  "companion_rain3": "धीमी, भारी भावनाओं के लिए यहाँ जगह है। आपके लिए भी।",
  "companion_rain4": "बारिश वाले दिन भी मायने रखते हैं। चेक-इन करने के लिए शुक्रिया।",
  "companion_rain5": "आज आपने ख़ुद से सच कहा। यह मायने रखता है।",
  "companion_rain6": "बारिश भी आपके आसमान का हिस्सा है।",
  "companion_rain7": "यह जितना भी भारी हो, आपने इसे पहचाना। इसकी अहमियत है।",
  "companion_rain8": "बादलों वाले दिनों में भी, आपकी चमक आपकी अपनी है।",
  "companion_moonlight1": "एक शांत, ठहरा हुआ पल। आपकी रोशनी आराम से है।",
  "companion_moonlight2": "एक शांत पल को पहचानना भी मायने रखता है। आपने अपना साथ दिया।",
  "companion_moonlight3": "नरम, हल्की भावनाओं के लिए यहाँ जगह है। आपके लिए भी।",
  "companion_moonlight4": "सुकून भरे दिन भी मायने रखते हैं। चेक-इन करने के लिए शुक्रिया।",
  "companion_moonlight5": "आपने इसे महसूस करने के लिए एक पल लिया। यह मायने रखता है।",
  "companion_moonlight6": "चाँदनी भी आपके आसमान का हिस्सा है।",
  "companion_moonlight7": "यह सुकून जितना भी छोटा हो, आपने इसे पहचाना। इसकी अहमियत है।",
  "companion_moonlight8": "इस ख़ामोशी में, आपकी चमक आपकी अपनी है।",
  "companion_sunrise1": "एक रोशन पल। आपकी रोशनी चमक रही है।",
