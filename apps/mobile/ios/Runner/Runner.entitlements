<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.declared-age-range</key>
	<true/>
	<!-- W06: read-only steps (HealthKit). Needs the HealthKit capability on
	     the App ID (Apple Developer > Identifiers); Xcode's automatic signing
	     enables it when the build uses -allowProvisioningUpdates. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.akvega.aura</string>
	</array>
</dict>
</plist>
