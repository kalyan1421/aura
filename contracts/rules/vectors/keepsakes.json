        "capsuleOpens": [{ "day": "2026-10-05", "amount": 1 }],
        "capsuleSeals": [{ "day": "2026-09-01", "amount": 1 }]
      },
      "expect": [
        { "key": "capsule_sealed_first", "day": "2026-09-01" },
        { "key": "capsule_opened_first", "day": "2026-10-05" },
        { "key": "ripples_first", "day": "2026-10-04" },
        { "key": "lantern_hours_1", "day": "2026-10-03" },
        { "key": "sanctuary_minutes_60", "day": "2026-10-02" }
      ]
    },
    {
      "kind": "capsule_years",
      "name": "no capsule, no anniversary",
      "firstSealed": null,
      "today": "2027-10-08",
      "expect": 0
    },
    {
      "kind": "capsule_years",
      "name": "the day before the first anniversary",
      "firstSealed": "2026-10-08",
      "today": "2027-10-07",
      "expect": 0
    },
    {
      "kind": "capsule_years",
      "name": "the first anniversary itself",
      "firstSealed": "2026-10-08",
      "today": "2027-10-08",
      "expect": 1
    },
    {
      "kind": "capsule_years",
      "name": "two years and a bit",
      "firstSealed": "2026-10-08",
      "today": "2028-12-31",
      "expect": 2
    },
    {
      "kind": "capsule_years",
      "name": "sealed on 29 Feb: the anniversary is 28 Feb in a common year",
