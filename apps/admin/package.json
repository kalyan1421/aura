{
  "name": "@aura/admin",
  "version": "0.1.0",
  "description": "Aura admin console v0 (internal): Next.js, server-rendered, talks only to the NestJS /admin routes. Port 3320.",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -p 3320",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -p 3320",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.mts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
