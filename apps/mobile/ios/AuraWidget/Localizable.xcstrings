          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "झटपट चेक-इन"
          }
        },
        "hi-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Jhatpat check-in"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "త్వరిత చెక్-ఇన్"
          }
        },
        "te-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick check-in"
          }
        }
      }
    },
