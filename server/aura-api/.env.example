# Aura API — copy to .env (gitignored). Local values: see supabase/LOCAL.md. Never commit real secrets.
NODE_ENV=development
PORT=3310
# Behind a load balancer: how many proxy hops to trust (e.g. 1) or their addresses/CIDRs, so per-client rate limits on
# the public routes see the client and not the balancer (SR-2, docs/security/milestone-b-review.md). Unset = trust none.
TRUST_PROXY=
WORKER_HEALTH_PORT=3311

# Service connection (postgres role; bypasses RLS — the API is the only writer of personal tables)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55522/postgres
DB_POOL_MAX=10

REDIS_URL=redis://127.0.0.1:6391

SUPABASE_URL=http://127.0.0.1:55521
# User sessions are ES256; verified via JWKS (default: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json).
# SUPABASE_JWKS_URL=
# Expected `iss` (default: ${SUPABASE_URL}/auth/v1)
# SUPABASE_JWT_ISSUER=
# Optional legacy HS256 fallback — only if the project still signs user sessions with the shared secret.
# SUPABASE_JWT_SECRET=

# DS-1 envelope master key: base64 of 32 random bytes →  openssl rand -base64 32
AURA_MASTER_KEY=

# Service role key — the private-media bucket is only reachable through the Storage API with it.
#  - API: signs voice-note upload/download URLs (POST /v1/media/*) and deletes a voice object when
#    a check-in edit clears it or the check-in is deleted. Without it /v1/media/* answer
#    503 media_unavailable and sync skips that cleanup (voicePath is still stored).
#  - WORKER: deletes a purged account's objects (account deletion, F8 REQ-ACC-11). Without it,
#    purges of accounts that have media are deferred (rows go; media + auth user wait).
# Also used by the e2e tests.
SUPABASE_SERVICE_ROLE_KEY=

# F14 push delivery (WORKER): a Firebase service account allowed to send FCM messages (Firebase console → Project
# settings → Service accounts → Generate new private key). Either the JSON itself / base64 of it, or a path to the file
# (GOOGLE_APPLICATION_CREDENTIALS also works). Unset → pushes are log-only (type logged, nothing delivered). Secret.
FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# FCM_PROJECT_ID=   (optional: overrides the key's project_id)

# Sign in with Apple token revocation (API + WORKER; App Review 5.1.1(v), docs/setup/social-sign-in.md §10). The
# API keeps each Apple user's refresh token (POST /v1/account/apple-auth) and revokes it when the account is deleted;
# the worker's purge revokes anything left. Unset → apple-auth answers 503 apple_unavailable (the app ignores it) and
# purges that find a stored token wait up to 72 h, then drop it unrevoked. APPLE_PRIVATE_KEY is the .p8 (PEM, the PEM
# with \n escapes, or its base64 body). Secret.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.akvega.aura
APPLE_PRIVATE_KEY=

# Admin console v0 (API + WORKER; docs/setup/admin-console.md). All optional: unset → mail and paging are off and the
# console's Paging page says so. Staff access itself comes from public.admin_staff (+ TOTP in Supabase Auth).
ADMIN_CONSOLE_URL=http://localhost:3320
# Optional second gate on top of admin_staff (comma-separated staff emails).
ADMIN_ALLOWED_EMAILS=
ADMIN_SESSION_MAX_HOURS=12
# Grievance Officer (IT Rules): shown by GET /v1/grievances/officer, in acknowledgements and replies.
GRIEVANCE_OFFICER_NAME=AK (Grievance Officer, AKVega)
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_ADDRESS=
# SMTP for grievance mail, email pages and the trial-ending email to app users (src/user-mail). Local: Mailpit
# (UI http://127.0.0.1:55524). Production: e.g. smtps://user:pass@smtp.provider.com:465 or
# smtp://user:pass@host:587?starttls=required. Secret.
SMTP_URL=smtp://127.0.0.1:55525
MAIL_FROM=Aura <no-reply@localhost>
# 24×7 paging: push webhook (json | ntfy | slack | pagerduty) at once, escalation webhook (the "voice call", e.g.
# PagerDuty high urgency / a Twilio Studio flow) from 5 min unacknowledged, and email. Tokens are secrets.
PAGING_WEBHOOK_URL=
PAGING_WEBHOOK_FORMAT=ntfy
PAGING_WEBHOOK_TOKEN=
PAGING_ESCALATION_WEBHOOK_URL=
PAGING_ESCALATION_WEBHOOK_FORMAT=pagerduty
PAGING_ESCALATION_WEBHOOK_TOKEN=
PAGING_EMAIL_TO=
# PAGING_REPEAT_MINUTES=5  PAGING_ESCALATE_AFTER_MINUTES=5  PAGING_TEST_MAX_ROUNDS=3
# PAGING_WEEKLY_TEST_CRON=0 10 * * 1   PAGING_WEEKLY_TEST_TZ=Asia/Kolkata   (off = no weekly drill)
# Shared secret for POST /v1/intake/legal-orders (an email-to-webhook relay); ≥ 32 chars. Unset → route answers 404. Secret.
LEGAL_INTAKE_TOKEN=
# App Review / Play review sign-in (POST /v1/auth/review-sign-in; docs/setup/app-review.md). Both set → the review
# account signs in with this fixed code instead of an emailed one (needs SUPABASE_SERVICE_ROLE_KEY). Either unset →
# the route answers 404. The email is matched case-insensitively; the code must be exactly 6 digits (the app's code
# field takes 6) — pick a random one. Remove both once review is done. Secret.
REVIEW_ACCOUNT_EMAIL=
REVIEW_ACCOUNT_CODE=
# REQ-ADM-01 staff sign-in. SSO = Supabase's Google provider, only for these Workspace domains (the `hd` claim).
# The email-code sign-in is development only: on by default only when NODE_ENV is development/test (fails closed when
# NODE_ENV is unset); ADMIN_ALLOW_EMAIL_LOGIN=true with NODE_ENV=production refuses to boot (SR-1, docs/security).
ADMIN_SSO_PROVIDER=
ADMIN_SSO_ALLOWED_DOMAINS=
ADMIN_ALLOW_EMAIL_LOGIN=
# PRD 19 queue sessions: 2 h of non-urgent review, then a 15-minute break (crisis and paging items stay open).
# ADMIN_QUEUE_SESSION_MINUTES=120  ADMIN_QUEUE_BREAK_MINUTES=15
# REQ-ADM-05: an open crisis report pages 24×7 after this many minutes (at once in India's / the room region's Lantern Hour).
# PAGING_CRISIS_AFTER_MINUTES=5
# REQ-ADM-11 deletion cases: the verification link in the email points here and expires after DELETION_LINK_TTL_HOURS.
PUBLIC_API_URL=http://127.0.0.1:3310
# DELETION_LINK_TTL_HOURS=72
# Nightly audit-log export (worker): NDJSON + manifest to a directory (0600) and/or an archive mailbox.
ADMIN_AUDIT_EXPORT_DIR=
ADMIN_AUDIT_EXPORT_EMAIL=
# ADMIN_AUDIT_EXPORT_CRON=30 2 * * *  ADMIN_AUDIT_EXPORT_TZ=Asia/Kolkata

# Signed crisis-lexicon versions + remote flags (API; PRD 19 REQ-ADM-12; docs/setup/lexicon-and-flags.md).
# Ed25519 private key that signs lexicon versions: base64 of the 32-byte seed (`pnpm lexicon keygen`) or a PKCS#8 PEM.
# Unset → development/test use the PUBLIC development key; production turns publishing off (503 signing_unavailable).
# The app build must trust the matching public key (--dart-define=AURA_BUNDLE_PUBLIC_KEYS=…). Secret.
LEXICON_SIGNING_KEY=
# REMOTE_CONFIG_POLL_SECONDS=240   (60–300: how often an open app re-fetches GET /v1/config)
# REMOTE_CONFIG_CACHE_MS=10000     (0–30000: per-instance cache of the config document)
# Forced update (MASVS F-6; docs/setup/lexicon-and-flags.md §4a): apps older than this show "Please update Aura".
# x.y.z (pubspec version name). Unset = no minimum. The `min_app_version` flag payload can raise it without a deploy.
# APP_MIN_VERSION_IOS=1.0.0
# APP_MIN_VERSION_ANDROID=1.0.0

# F6 Reflections (API; contracts/api/v1-reflections.md §3; PRD REQ-REF-07: the ONLY external classifier). OpenAI
# omni-moderation receives the reflection text only; request zero data retention on the OpenAI organisation. Unset →
# reflections fail closed: everything the on-server text rules don't decide is HELD for human review (logged at boot
# and on each hold, never with text). Secret.
OPENAI_API_KEY=
# OPENAI_MODERATION_URL=https://api.openai.com/v1/moderations   OPENAI_MODERATION_MODEL=omni-moderation-latest

# F12 Monetization (API + worker; contracts/api/v1-billing.md §7). Nothing here is needed to boot: without store
# credentials purchases stay "confirming" (nothing granted) until a store notification settles them. Secrets.
# App Store: bundle id, numeric Apple ID of the app (production notifications must carry it), and an In-App Purchase
# key (App Store Connect → Users and Access → Integrations → In-App Purchase) for the App Store Server API.
APPLE_IAP_BUNDLE_ID=com.akvega.aura
APPLE_IAP_APP_APPLE_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
# Google Play: package name and a service account with "View financial data" + "Manage orders and subscriptions"
# (Play Console → Users and permissions): JSON (or base64 of it) inline, or a file path.
GOOGLE_PLAY_PACKAGE_NAME=com.akvega.aura
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
# Play RTDN over an authenticated Pub/Sub push subscription: the audience set on the subscription (usually the push
# URL https://<api>/v1/billing/webhooks/google) and the push service account's email. Unset → pushes refused (503).
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_SERVICE_ACCOUNT=
# BILLING_ACCEPT_SANDBOX=true   (TestFlight / App Review / Play licence testers buy in the sandbox)

# --- e2e tests only (not read by the app) ---
SUPABASE_ANON_KEY=

# Verified TLS to Supabase: paste the Supabase Root 2021 CA PEM (Database settings → SSL) with \n for newlines.
DATABASE_CA_CERT=
# Individual Google accounts allowed to sign in to the console without a Workspace domain.
ADMIN_SSO_ALLOWED_ACCOUNTS=
