{
  "cases": [
    { "kind": "parse", "name": "full", "input": "1.4.0+57", "expect": { "major": 1, "minor": 4, "patch": 0, "build": 57 } },
    { "kind": "parse", "name": "no build", "input": "1.4.0", "expect": { "major": 1, "minor": 4, "patch": 0, "build": null } },
    { "kind": "parse", "name": "major only", "input": "2", "expect": { "major": 2, "minor": 0, "patch": 0, "build": null } },
    { "kind": "parse", "name": "major.minor", "input": "2.3", "expect": { "major": 2, "minor": 3, "patch": 0, "build": null } },
    { "kind": "parse", "name": "trimmed", "input": "  1.2.3  ", "expect": { "major": 1, "minor": 2, "patch": 3, "build": null } },
    { "kind": "parse", "name": "leading v refused", "input": "v1.2.3", "expect": null },
    { "kind": "parse", "name": "four parts refused", "input": "1.2.3.4", "expect": null },
    { "kind": "parse", "name": "pre-release refused", "input": "1.2.3-beta", "expect": null },
    { "kind": "parse", "name": "empty refused", "input": "", "expect": null },
    { "kind": "parse", "name": "not a string", "input": 123, "expect": null },
    { "kind": "compare", "name": "numeric, not text", "a": "1.10.0", "b": "1.9.0", "expect": 1 },
    { "kind": "compare", "name": "patch", "a": "1.2.3", "b": "1.2.4", "expect": -1 },
    { "kind": "compare", "name": "missing parts are 0", "a": "1.2", "b": "1.2.0", "expect": 0 },
    { "kind": "compare", "name": "build breaks a tie when both have one", "a": "1.2.0+5", "b": "1.2.0+7", "expect": -1 },
    { "kind": "compare", "name": "build ignored when one side has none", "a": "1.2.0", "b": "1.2.0+7", "expect": 0 },
    { "kind": "compare", "name": "build never outranks the version", "a": "1.2.0+999", "b": "1.3.0+1", "expect": -1 },
    { "kind": "required", "name": "older install must update", "installed": "1.0.0+4", "minimum": "1.1.0", "expect": true },
    { "kind": "required", "name": "same version is fine", "installed": "1.1.0+9", "minimum": "1.1.0", "expect": false },
    { "kind": "required", "name": "newer install is fine", "installed": "2.0.0+1", "minimum": "1.9.9", "expect": false },
    { "kind": "required", "name": "build-level minimum", "installed": "1.1.0+8", "minimum": "1.1.0+9", "expect": true },
    { "kind": "required", "name": "unreadable install never blocks", "installed": null, "minimum": "9.0.0", "expect": false },
    { "kind": "required", "name": "malformed minimum never blocks", "installed": "1.0.0+1", "minimum": "latest", "expect": false }
  ]
}
