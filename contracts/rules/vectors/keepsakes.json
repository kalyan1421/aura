      },
      "expect": [{ "key": "lantern_hours_10", "day": "2026-11-02" }]
    },
    {
      "kind": "earned",
      "name": "thresholds already inside the tally are not re-dated",
      "sources": {
        "lanternNights": [{ "day": "2026-12-01", "amount": 1 }],
        "lanternCounted": 10
      },
      "expect": []
    },
    {
      "kind": "earned",
      "name": "the tally alone (rooms purged) earns nothing new",
      "sources": {
        "lanternNights": [],
        "lanternCounted": 49
      },
      "expect": []
    },
    {
      "kind": "earned",
      "name": "the 50th Lantern Hour",
      "sources": {
        "lanternNights": [{ "day": "2027-03-03", "amount": 1 }],
        "lanternCounted": 49
      },
      "expect": [{ "key": "lantern_hours_50", "day": "2027-03-03" }]
    },
    {
      "kind": "earned",
      "name": "59 Sanctuary minutes and 59 seconds is not 60",
      "sources": {
        "sanctuarySeconds": [
          { "day": "2026-10-01", "amount": 1800 },
          { "day": "2026-10-02", "amount": 1799 }
        ]
      },
      "expect": []
    },
    {
      "kind": "earned",
      "name": "exactly 60 minutes across sessions, dated by the day the total reaches it",
      "sources": {
        "sanctuarySeconds": [
          { "day": "2026-10-03", "amount": 1 },
          { "day": "2026-10-01", "amount": 1800 },
          { "day": "2026-10-02", "amount": 1799 }
        ]
      },
      "expect": [{ "key": "sanctuary_minutes_60", "day": "2026-10-03" }]
    },
    {
      "kind": "earned",
      "name": "one long session can cross several thresholds on the same day",
      "sources": {
        "sanctuarySeconds": [
          { "day": "2026-10-01", "amount": 600 },
          { "day": "2026-10-04", "amount": 43200 },
          { "day": "2026-10-05", "amount": 17000 }
        ]
      },
      "expect": [
        { "key": "sanctuary_minutes_60", "day": "2026-10-04" },
        { "key": "sanctuary_minutes_300", "day": "2026-10-04" },
        { "key": "sanctuary_minutes_1000", "day": "2026-10-05" }
      ]
    },
    {
      "kind": "earned",
      "name": "zero and negative amounts are ignored",
      "sources": {
        "sanctuarySeconds": [
          { "day": "2026-10-01", "amount": -5000 },
          { "day": "2026-10-02", "amount": 0 },
          { "day": "2026-10-03", "amount": 3599 }
        ],
        "capsuleSeals": [{ "day": "2026-10-02", "amount": 0 }]
      },
      "expect": []
    },
    {
      "kind": "earned",
      "name": "everything at once comes back in catalogue order",
      "sources": {
        "sanctuarySeconds": [{ "day": "2026-10-02", "amount": 3600 }],
