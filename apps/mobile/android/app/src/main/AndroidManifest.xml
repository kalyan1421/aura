<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Sync with NestJS and Supabase. The app works fully offline without it. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Android 13+ notifications. Requested only after the first check-in,
         behind the in-app explainer (PRD 15-permissions); never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- F1 voice notes: requested on the first mic tap, after the in-app
         explainer (PRD 15-permissions). Foreground recording only: no
         foreground service, no background audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- F4 capsule "ready to open" notices (flutter_local_notifications):
         scheduled notifications are restored after a reboot. Inexact
         scheduling only: no exact-alarm permission (PRD 15-permissions). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- F15 Sounds (Milestone B): playback continues with the screen off in
         a media-playback foreground service with its notification controls
         (PRD 15-permissions "Background audio"). Install-time, no prompt.
         Only while the person plays Sounds; never for recording. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- No advertising id (PRD 13-analytics principle 8, 15-permissions
         "Tracking"): Aura has no ad SDKs. Some Google libraries merge AD_ID
         in; removing it keeps the Data safety form and the binary in step.
         MASVS-PRIVACY (docs/security/masvs-l1.md). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <!-- Nothing leaves the phone through OS backup (PRD 16-offline: the
         encrypted DB and voice files are restored from the server, never from
         a backup). allowBackup=false stops cloud backup, but on Android 12+
         it no longer stops device-to-device transfer; the data-extraction
         rules exclude every domain from both.
         usesCleartextTraffic=false: release traffic is HTTPS only. Android 9+
         already refuses cleartext by default, but minSdk is 24, and 7.x/8.x
         allow it unless the app says no (MASVS-NETWORK-1). Debug and profile
         builds override this for the local dev stack (src/debug, src/profile). -->
    <application
        android:label="Aura"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase magic link: aura://auth-callback (supabase/config.toml). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="aura" android:host="auth-callback"/>
            </intent-filter>
            <!-- App deep links (core/router/deep_links.dart): aura://checkin,
                 aura://safety, aura://sanctuary, aura://rooms. The router
                 applies the gate (under-13 lock, onboarding) before opening
                 them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="aura" android:host="checkin"/>
                <data android:scheme="aura" android:host="safety"/>
                <data android:scheme="aura" android:host="sanctuary"/>
                <data android:scheme="aura" android:host="rooms"/>
            </intent-filter>
        </activity>
        <!-- FCM: no token is created until the user opts in after the first
             check-in (PushService turns auto-init on, and off at sign-out). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- F14 pushes (features/push): a monochrome status-bar icon (the
             full-colour launcher icon would show as a white square), and the
             Reminders channel (created by the app) for any message that
             names no channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_aura" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reminders" />
        <!-- No Firebase Analytics: product analytics are PostHog. -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <!-- flutter_local_notifications: shows scheduled notices (F4 capsule
             unlocks) and re-schedules them after a reboot or an update. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- F15 Sounds: audio_service's media-playback service and media
             button receiver (lock-screen / notification / headset controls,
             which only ever read "Aura · Sounds"). -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
        <!-- F11 home-screen widget (Jetpack Glance, com.akvega.aura.widget):
             2x2 opens aura://checkin, 4x2 saves a mood-only check-in to
             app-private storage in two taps; the app imports and syncs it. -->
        <receiver
            android:name=".widget.AuraWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_galleryName">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aura_widget_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Tap-to-call helplines (url_launcher tel:). -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
