<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.akvega.aura.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aura</string>
			</array>
		</dict>
		<!-- Sign in with Google returns through the reversed iOS OAuth client id
		     (com.googleusercontent.apps.…). Set in the gitignored
		     Flutter/Secrets.xcconfig; a harmless placeholder otherwise
		     (Flutter/Debug.xcconfig, docs/setup/social-sign-in.md). -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.akvega.aura.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(AURA_GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
	</array>
	<!-- F1 voice notes: asked on the first mic tap, after the in-app explainer
	     (PRD 15-permissions wording). Foreground recording only. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>To record a voice note, Aura needs your microphone. Recordings stay private to you and are never shared in rooms.</string>
	<!-- F4 capsule photos come from PHPicker with requestFullMetadata: false,
	     which never asks for library access (PRD 15-permissions). The key is
	     here only because App Store review requires it of any binary that
	     links image_picker (its README); the prompt is never shown. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Only if you choose "Save Image" when sharing a card: Aura saves that one picture and never reads your photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Aura only sees the photos you choose to add to a capsule. They stay private to you.</string>
	<!-- No NSAppTransportSecurity here: ATS is fully on. The local dev stack's
	     NSAllowsLocalNetworking (http to localhost:3310 / :55521) is added to
	     Debug builds only by the "ATS (Debug only)" build phase
	     (ios/scripts/ats_debug_only.sh, MASVS F-4); Release and Profile builds
	     fail if any ATS exception is present. -->
	<!-- audio: F15 Sounds keep playing with the screen locked (PRD
	     15-permissions "Background audio"). Used only while the person is
	     playing Sounds; no silent keep-alive audio, never for recording. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<!-- F11 widget background refresh (AuraWidgetChannel.swift
	     AuraWidgetBackgroundSync): imports widget check-ins and syncs. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.akvega.aura.widget-sync</string>
	</array>
	<!-- FCM: no token until the user opts in after the first check-in
	     (PushService enables auto-init then, and disables it at sign-out). -->
	<key>FirebaseMessagingAutoInitEnabled</key>
	<false/>
	<!-- No Firebase Analytics: product analytics are PostHog. -->
	<key>FIREBASE_ANALYTICS_COLLECTION_DEACTIVATED</key>
	<true/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Aura</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Aura</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
