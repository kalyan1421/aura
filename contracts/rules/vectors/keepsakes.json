      "today": "2029-02-28",
      "expect": 1
    },
    {
      "kind": "capsule_years",
      "name": "a first seal dated in the future (clock skew) counts nothing",
      "firstSealed": "2027-01-01",
      "today": "2026-12-31",
      "expect": 0
    },
    {
      "kind": "share_prompt",
      "name": "a new Spark has nothing to share",
      "state": { "stage": "spark", "lifetimeGlowDays": 3, "capsuleYears": 0, "offered": [], "hideGlow": false },
      "expect": { "prompt": null, "offer": [] }
    },
    {
      "kind": "share_prompt",
      "name": "reaching Ember offers its evolution card",
      "state": { "stage": "ember", "lifetimeGlowDays": 6, "capsuleYears": 0, "offered": [], "hideGlow": false },
      "expect": { "prompt": "evolution:ember", "offer": ["evolution:ember"] }
    },
    {
      "kind": "share_prompt",
      "name": "offered once: an offered milestone is never offered again",
      "state": { "stage": "ember", "lifetimeGlowDays": 6, "capsuleYears": 0, "offered": ["evolution:ember"], "hideGlow": false },
      "expect": { "prompt": null, "offer": [] }
    },
    {
      "kind": "share_prompt",
      "name": "the 7th glow day offers the glow card",
      "state": { "stage": "ember", "lifetimeGlowDays": 7, "capsuleYears": 0, "offered": ["evolution:ember"], "hideGlow": false },
      "expect": { "prompt": "glow:7", "offer": ["glow:7"] }
    },
    {
      "kind": "share_prompt",
      "name": "several at once: one prompt for the highest, all of them marked offered",
      "state": { "stage": "radiance", "lifetimeGlowDays": 120, "capsuleYears": 1, "offered": [], "hideGlow": false },
      "expect": {
        "prompt": "evolution:radiance",
        "offer": [
          "evolution:ember",
          "evolution:glow",
          "evolution:radiance",
          "glow:7",
          "glow:30",
          "glow:100",
          "capsule_anniversary:1"
        ]
      }
    },
    {
      "kind": "share_prompt",
      "name": "glow outranks a capsule anniversary",
      "state": { "stage": "glow", "lifetimeGlowDays": 30, "capsuleYears": 1, "offered": ["evolution:ember", "evolution:glow", "glow:7"], "hideGlow": false },
      "expect": { "prompt": "glow:30", "offer": ["glow:30", "capsule_anniversary:1"] }
    },
    {
      "kind": "share_prompt",
      "name": "a capsule anniversary on its own",
      "state": { "stage": "ember", "lifetimeGlowDays": 5, "capsuleYears": 2, "offered": ["evolution:ember", "capsule_anniversary:1"], "hideGlow": false },
      "expect": { "prompt": "capsule_anniversary:2", "offer": ["capsule_anniversary:2"] }
    },
    {
      "kind": "share_prompt",
      "name": "Comfort 'hide streak': glow milestones are never prompted, only quietly marked offered",
      "state": { "stage": "ember", "lifetimeGlowDays": 30, "capsuleYears": 0, "offered": ["evolution:ember"], "hideGlow": true },
      "expect": { "prompt": null, "offer": ["glow:7", "glow:30"] }
    },
    {
      "kind": "share_prompt",
      "name": "hide streak still prompts the evolution card",
      "state": { "stage": "constellation", "lifetimeGlowDays": 400, "capsuleYears": 0, "offered": ["evolution:ember", "evolution:glow", "evolution:radiance"], "hideGlow": true },
      "expect": {
        "prompt": "evolution:constellation",
        "offer": ["evolution:constellation", "glow:7", "glow:30", "glow:100", "glow:365"]
      }
    }
