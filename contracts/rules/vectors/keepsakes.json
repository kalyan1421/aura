  "cases": [
    {
      "kind": "earned",
      "name": "nothing yet earns nothing",
      "sources": {},
      "expect": []
    },
    {
      "kind": "earned",
      "name": "the first capsule sealed is dated by the earliest seal, whatever the order",
      "sources": {
        "capsuleSeals": [
          { "day": "2026-10-09", "amount": 1 },
          { "day": "2026-10-05", "amount": 1 },
          { "day": "2026-10-07", "amount": 1 }
        ]
      },
      "expect": [{ "key": "capsule_sealed_first", "day": "2026-10-05" }]
    },
    {
      "kind": "earned",
      "name": "sealed and opened are separate seals",
      "sources": {
        "capsuleSeals": [{ "day": "2026-10-05", "amount": 1 }],
        "capsuleOpens": [{ "day": "2026-10-12", "amount": 1 }]
      },
      "expect": [
        { "key": "capsule_sealed_first", "day": "2026-10-05" },
        { "key": "capsule_opened_first", "day": "2026-10-12" }
      ]
    },
    {
      "kind": "earned",
      "name": "6 glow days is not yet 7",
      "sources": {
        "glowDays": [
          { "day": "2026-10-01", "amount": 1 },
          { "day": "2026-10-02", "amount": 1 },
          { "day": "2026-10-03", "amount": 1 },
          { "day": "2026-10-05", "amount": 1 },
          { "day": "2026-10-06", "amount": 1 },
          { "day": "2026-10-09", "amount": 1 }
        ]
      },
      "expect": []
    },
    {
      "kind": "earned",
      "name": "the 7th distinct glow day earns glow_days_7 on that day (gaps and duplicates don't matter)",
      "sources": {
        "glowDays": [
          { "day": "2026-10-09", "amount": 1 },
          { "day": "2026-10-01", "amount": 1 },
          { "day": "2026-10-02", "amount": 1 },
          { "day": "2026-10-02", "amount": 1 },
          { "day": "2026-10-03", "amount": 1 },
          { "day": "2026-10-05", "amount": 1 },
          { "day": "2026-10-06", "amount": 1 },
          { "day": "2026-10-20", "amount": 1 }
        ]
      },
      "expect": [{ "key": "glow_days_7", "day": "2026-10-20" }]
    },
    {
      "kind": "earned",
      "name": "a glow day counts once however large its amount",
      "sources": {
        "glowDays": [
          { "day": "2026-10-01", "amount": 5 },
          { "day": "2026-10-02", "amount": 5 }
        ]
      },
      "expect": []
    },
    {
      "kind": "earned",
      "name": "30 glow days earns 7 and 30, each on its own day",
      "sources": {
        "glowDaysRange": { "from": "2026-11-01", "count": 30 }
      },
      "expect": [
        { "key": "glow_days_7", "day": "2026-11-07" },
        { "key": "glow_days_30", "day": "2026-11-30" }
      ]
    },
    {
      "kind": "earned",
      "name": "365 glow days earns all four glow seals",
      "sources": {
        "glowDaysRange": { "from": "2027-01-01", "count": 365 }
      },
      "expect": [
        { "key": "glow_days_7", "day": "2027-01-07" },
        { "key": "glow_days_30", "day": "2027-01-30" },
        { "key": "glow_days_100", "day": "2027-04-10" },
        { "key": "glow_days_365", "day": "2027-12-31" }
      ]
    },
    {
