# Aura API — copy to .env (gitignored). Local values: see supabase/LOCAL.md. Never commit real secrets.
NODE_ENV=development
PORT=3310
WORKER_HEALTH_PORT=3311

# Service connection (postgres role; bypasses RLS — the API is the only writer of personal tables)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55522/postgres
DB_POOL_MAX=10

REDIS_URL=redis://127.0.0.1:6391

SUPABASE_URL=http://127.0.0.1:55521
# User sessions are ES256; verified via JWKS (default: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json).
# SUPABASE_JWKS_URL=
# Expected `iss` (default: ${SUPABASE_URL}/auth/v1)
# SUPABASE_JWT_ISSUER=
# Optional legacy HS256 fallback — only if the project still signs user sessions with the shared secret.
# SUPABASE_JWT_SECRET=

# DS-1 envelope master key: base64 of 32 random bytes →  openssl rand -base64 32
AURA_MASTER_KEY=

# Service role key. The WORKER needs it to delete a purged account's objects in the
# private-media bucket via the Storage API (account deletion, F8 REQ-ACC-11). Without it,
# purges of accounts that have media are deferred (rows go; media + auth user wait).
# Also used by the e2e tests.
SUPABASE_SERVICE_ROLE_KEY=

# --- e2e tests only (not read by the app) ---
SUPABASE_ANON_KEY=
