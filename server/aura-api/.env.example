# Aura API — copy to .env (gitignored). Local values: see supabase/LOCAL.md. Never commit real secrets.
NODE_ENV=development
PORT=3310
WORKER_HEALTH_PORT=3311

# Service connection (postgres role; bypasses RLS — the API is the only writer of personal tables)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55522/postgres
DB_POOL_MAX=10

REDIS_URL=redis://127.0.0.1:6391

SUPABASE_URL=http://127.0.0.1:55521
# User sessions are ES256; verified via JWKS (default: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json).
# SUPABASE_JWKS_URL=
# Expected `iss` (default: ${SUPABASE_URL}/auth/v1)
# SUPABASE_JWT_ISSUER=
# Optional legacy HS256 fallback — only if the project still signs user sessions with the shared secret.
# SUPABASE_JWT_SECRET=

# DS-1 envelope master key: base64 of 32 random bytes →  openssl rand -base64 32
AURA_MASTER_KEY=

# Service role key — the private-media bucket is only reachable through the Storage API with it.
#  - API: signs voice-note upload/download URLs (POST /v1/media/*) and deletes a voice object when
#    a check-in edit clears it or the check-in is deleted. Without it /v1/media/* answer
#    503 media_unavailable and sync skips that cleanup (voicePath is still stored).
#  - WORKER: deletes a purged account's objects (account deletion, F8 REQ-ACC-11). Without it,
#    purges of accounts that have media are deferred (rows go; media + auth user wait).
# Also used by the e2e tests.
SUPABASE_SERVICE_ROLE_KEY=

# F14 push delivery (WORKER): a Firebase service account allowed to send FCM messages (Firebase console → Project
# settings → Service accounts → Generate new private key). Either the JSON itself / base64 of it, or a path to the file
# (GOOGLE_APPLICATION_CREDENTIALS also works). Unset → pushes are log-only (type logged, nothing delivered). Secret.
FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
# FCM_PROJECT_ID=   (optional: overrides the key's project_id)

# Sign in with Apple token revocation (API + WORKER; App Review 5.1.1(v), docs/setup/social-sign-in.md §10). The
# API keeps each Apple user's refresh token (POST /v1/account/apple-auth) and revokes it when the account is deleted;
# the worker's purge revokes anything left. Unset → apple-auth answers 503 apple_unavailable (the app ignores it) and
# purges that find a stored token wait up to 72 h, then drop it unrevoked. APPLE_PRIVATE_KEY is the .p8 (PEM, the PEM
# with \n escapes, or its base64 body). Secret.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.akvega.aura
APPLE_PRIVATE_KEY=

# Admin console v0 (API + WORKER; docs/setup/admin-console.md). All optional: unset → mail and paging are off and the
# console's Paging page says so. Staff access itself comes from public.admin_staff (+ TOTP in Supabase Auth).
ADMIN_CONSOLE_URL=http://localhost:3320
# Optional second gate on top of admin_staff (comma-separated staff emails).
ADMIN_ALLOWED_EMAILS=
ADMIN_SESSION_MAX_HOURS=12
# Grievance Officer (IT Rules): shown by GET /v1/grievances/officer, in acknowledgements and replies.
GRIEVANCE_OFFICER_NAME=AK (Grievance Officer, AKVega)
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_ADDRESS=
# SMTP for grievance mail and email pages. Local: Mailpit (UI http://127.0.0.1:55524). Production: e.g.
# smtps://user:pass@smtp.provider.com:465 or smtp://user:pass@host:587?starttls=required. Secret.
SMTP_URL=smtp://127.0.0.1:55525
MAIL_FROM=Aura <no-reply@localhost>
# 24×7 paging: push webhook (json | ntfy | slack | pagerduty) at once, escalation webhook (the "voice call", e.g.
# PagerDuty high urgency / a Twilio Studio flow) from 5 min unacknowledged, and email. Tokens are secrets.
PAGING_WEBHOOK_URL=
PAGING_WEBHOOK_FORMAT=ntfy
PAGING_WEBHOOK_TOKEN=
PAGING_ESCALATION_WEBHOOK_URL=
PAGING_ESCALATION_WEBHOOK_FORMAT=pagerduty
PAGING_ESCALATION_WEBHOOK_TOKEN=
PAGING_EMAIL_TO=
# PAGING_REPEAT_MINUTES=5  PAGING_ESCALATE_AFTER_MINUTES=5  PAGING_TEST_MAX_ROUNDS=3
# PAGING_WEEKLY_TEST_CRON=0 10 * * 1   PAGING_WEEKLY_TEST_TZ=Asia/Kolkata   (off = no weekly drill)
# Shared secret for POST /v1/intake/legal-orders (an email-to-webhook relay); ≥ 32 chars. Unset → route answers 404. Secret.
LEGAL_INTAKE_TOKEN=

# --- e2e tests only (not read by the app) ---
SUPABASE_ANON_KEY=
