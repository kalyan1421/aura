    "widget_prompt": {
      "comment": "GENERATED by tool/gen_widget_strings.py from lib/l10n/app_*.arb. Do not edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How are you feeling?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कैसा लग रहा है?"
          }
        },
        "hi-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhi kaisa lag raha hai?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు ఇప్పుడు ఎలా అనిపిస్తోంది?"
          }
        },
        "te-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeku ippudu ela anipistondi?"
          }
        }
      }
    },
