    "widget_openApp": {
      "comment": "GENERATED by tool/gen_widget_strings.py from lib/l10n/app_*.arb. Do not edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Aura to continue"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगे बढ़ने के लिए Aura खोलें"
          }
        },
        "hi-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aage badhne ke liye Aura kholein"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనసాగించడానికి Aura తెరవండి"
          }
        },
        "te-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue cheyadaaniki Aura open cheyandi"
          }
        }
      }
    },
