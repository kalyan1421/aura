    "widget_doneToday": {
      "comment": "GENERATED by tool/gen_widget_strings.py from lib/l10n/app_*.arb. Do not edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked in today"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज चेक-इन हो गया"
          }
        },
        "hi-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aaj check-in ho gaya"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈరోజు చెక్-ఇన్ అయింది"
          }
        },
        "te-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ee roju check-in ayyindi"
          }
        }
      }
    },
    "widget_galleryDescription": {
      "comment": "GENERATED by tool/gen_widget_strings.py from lib/l10n/app_*.arb. Do not edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in with two taps, right from your home screen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम स्क्रीन से ही दो टैप में चेक-इन करें।"
          }
        },
        "hi-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Home screen se hi do taps mein check-in karein."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హోమ్ స్క్రీన్ నుండే రెండు ట్యాప్‌లతో చెక్-ఇన్ చేయండి."
          }
        },
        "te-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Home screen nunde rendu taps tho check-in cheyandi."
          }
        }
      }
    },
    "widget_galleryName": {
      "comment": "GENERATED by tool/gen_widget_strings.py from lib/l10n/app_*.arb. Do not edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura check-in"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura चेक-इन"
          }
        },
        "hi-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura check-in"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura చెక్-ఇన్"
          }
        },
        "te-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura check-in"
          }
        }
      }
    },
    "widget_lockGalleryDescription": {
      "comment": "GENERATED by tool/gen_widget_strings.py from lib/l10n/app_*.arb. Do not edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A star that opens your check-in. It never shows how you feel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक तारा जो आपका चेक-इन खोलता है। यह कभी नहीं दिखाता कि आपका मन कैसा है।"
          }
        },
        "hi-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek taara jo aapka check-in kholta hai. Ye kabhi nahi dikhata ki aapka mann kaisa hai."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ చెక్-ఇన్‌ను తెరిచే ఒక నక్షత్రం. మీకు ఎలా అనిపిస్తోందో అది ఎప్పుడూ చూపించదు."
          }
        },
        "te-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mee check-in open chese oka star. Meeku ela anipistondo adi eppudu choopinchadu."
          }
        }
      }
    },
    "widget_lockGalleryName": {
      "comment": "GENERATED by tool/gen_widget_strings.py from lib/l10n/app_*.arb. Do not edit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
